{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mela.ai/schemas/thought-archaeology/v1/graph-diff.schema.json",
  "title": "GraphDiff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "a_graph_id",
    "b_graph_id",
    "stable_node_ids",
    "changed_node_ids",
    "vanished_node_ids",
    "appeared_node_ids"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "a_graph_id": {
      "type": "string",
      "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$"
    },
    "b_graph_id": {
      "type": "string",
      "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$"
    },
    "stable_node_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$"
      }
    },
    "changed_node_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$"
      }
    },
    "vanished_node_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$"
      }
    },
    "appeared_node_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$"
      }
    },
    "notes": { "type": ["string", "null"] }
  }
}
