{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mela.ai/schemas/thought-archaeology/v1/neural-intervention.schema.json",
  "title": "NeuralIntervention",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "attribution_id", "graph_id", "node_id", "prompt", "target", "edit", "hypothesis", "baseline", "intervened", "observed_delta", "result", "execution", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$"},
    "attribution_id": {"type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$"},
    "graph_id": {"type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$"},
    "node_id": {"type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$"},
    "prompt": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "edit": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "layer", "position", "feature_index", "baseline_activation", "set_to", "delta"],
      "properties": {
        "operation": {"enum": ["set_value", "ablate", "add_delta"]},
        "layer": {"type": "integer", "minimum": 0},
        "position": {"type": "integer", "minimum": 0},
        "feature_index": {"type": "integer", "minimum": 0},
        "baseline_activation": {"type": ["number", "null"]},
        "set_to": {"type": ["number", "null"]},
        "delta": {"type": ["number", "null"]}
      }
    },
    "hypothesis": {
      "type": "object", "additionalProperties": false,
      "required": ["metric", "expected_direction", "minimum_absolute_change"],
      "properties": {
        "metric": {"enum": ["target_logit", "target_probability", "target_token_generated"]},
        "expected_direction": {"enum": ["increase", "decrease", "change"]},
        "minimum_absolute_change": {"type": "number", "minimum": 0}
      }
    },
    "baseline": {"$ref": "#/$defs/observation"},
    "intervened": {"$ref": "#/$defs/observation"},
    "observed_delta": {"type": "number"},
    "result": {"enum": ["supports", "contradicts", "inconclusive"]},
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "method", "runner_revision", "device", "source_uri", "source_sha256"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "runner_revision": {"type": "string", "minLength": 1},
        "device": {"type": "string", "minLength": 1},
        "source_uri": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  },
  "$defs": {
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["target_value", "top_token"],
      "properties": {
        "target_value": {"type": "number"},
        "top_token": {"type": "string", "minLength": 1}
      }
    }
  }
}
