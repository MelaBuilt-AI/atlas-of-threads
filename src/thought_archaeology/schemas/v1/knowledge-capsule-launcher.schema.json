{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mela.ai/schemas/thought-archaeology/v1/knowledge-capsule-launcher.schema.json",
  "title": "KnowledgeCapsuleLauncher",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "stored_at", "author", "session_id",
    "earning_graph_id", "earning_node_id", "field_note_id",
    "field_note_revision_id", "comparison_request_id"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "stored_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "author": { "const": "human" },
    "session_id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "earning_graph_id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "earning_node_id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "field_note_id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "field_note_revision_id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "comparison_request_id": { "type": ["string", "null"], "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" }
  }
}
