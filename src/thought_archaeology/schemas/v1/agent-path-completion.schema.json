{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mela.ai/schemas/thought-archaeology/v1/agent-path-completion.schema.json",
  "title": "AgentPathCompletion",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "interaction_id", "collaborator_id", "created_at", "client_request_id", "request_sha256", "session_id", "source_graph_id", "source_node_id", "graph_id", "turn_id", "model", "harness", "warnings", "visibility", "transport"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "interaction_id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "collaborator_id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "client_request_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "request_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "session_id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "source_graph_id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "source_node_id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "graph_id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "turn_id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "model": { "$ref": "#/$defs/publicMetadata" },
    "harness": { "$ref": "#/$defs/publicMetadata" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "visibility": { "const": "private" },
    "transport": { "const": "mcp" }
  },
  "$defs": {
    "publicMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 200 },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    }
  }
}
