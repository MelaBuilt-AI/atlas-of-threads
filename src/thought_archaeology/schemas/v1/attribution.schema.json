{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mela.ai/schemas/thought-archaeology/v1/attribution.schema.json",
  "title": "Attribution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "graph_id",
    "node_id",
    "span",
    "supernodes",
    "raw_feature_count",
    "vendor",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "graph_id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "node_id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "unit"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 },
        "unit": { "const": "char" }
      }
    },
    "supernodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/supernode" }
    },
    "raw_feature_count": { "type": "integer", "minimum": 0 },
    "vendor": {
      "type": "string",
      "enum": ["none", "neuronpedia", "anthropic", "custom"]
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  },
  "$defs": {
    "supernode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1, "maxLength": 400 },
        "nla_sentence": { "type": ["string", "null"] },
        "feature_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "exemplars": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "suppressed": { "type": "boolean" }
      }
    }
  }
}
