{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mela.ai/schemas/thought-archaeology/v1/agent-collaborator.schema.json",
  "title": "AgentCollaborator",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "created_at", "display_name", "client_family", "scopes"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "client_family": { "type": "string", "minLength": 1, "maxLength": 200 },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["atlas:read", "atlas:write:threadwalk", "atlas:write:path", "atlas:memory:ack"]
      }
    }
  }
}
