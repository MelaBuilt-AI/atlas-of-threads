{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mela.ai/schemas/thought-archaeology/v1/agent-interaction.schema.json",
  "title": "AgentInteraction",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "collaborator_id", "created_at", "client_request_id", "request_sha256", "session_id", "root_turn_id", "root_graph_id", "root_node_id", "seed", "seed_origin", "title", "visibility", "transport"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "collaborator_id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "client_request_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "request_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "session_id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "root_turn_id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "root_graph_id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "root_node_id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "seed": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "seed_origin": { "enum": ["human_instruction", "agent_proposal"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "visibility": { "const": "private" },
    "transport": { "const": "mcp" }
  }
}
