{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mela.ai/schemas/thought-archaeology/v1/knowledge-capsule-manifest.schema.json",
  "title": "KnowledgeCapsuleManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "created_at", "author",
    "comparison_request_id", "session_id", "session_title", "source_graph_id", "source_node_id",
    "head_graph_id", "head_turn_id", "field_note_id", "field_note_revision_id",
    "rendering_version", "privacy_warning", "omissions", "artifacts"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "author": { "const": "human" },
    "comparison_request_id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "session_id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "session_title": { "type": "string", "minLength": 1, "maxLength": 500 },
    "source_graph_id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "source_node_id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "head_graph_id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "head_turn_id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "field_note_id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "field_note_revision_id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "rendering_version": { "const": "1" },
    "privacy_warning": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "omissions": {
      "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "artifacts": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "id", "path", "sha256"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "turn", "graph", "continuation_request", "continuation_attempt",
              "continuation_completion", "continuation_failure",
              "continuation_cancellation", "parallel_continuation_batch",
              "field_note", "field_note_revision", "probe", "graph_diff",
              "evidence_binding", "attribution", "neural_intervention",
              "training_provenance"
            ]
          },
          "id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
          "path": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^/].*" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
