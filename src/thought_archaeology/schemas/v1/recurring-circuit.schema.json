{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mela.ai/schemas/thought-archaeology/v1/recurring-circuit.schema.json",
  "title": "RecurringCircuit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "model", "identity_rule", "feature", "minimum_contexts", "contexts", "supporting_count", "contradicting_count", "inconclusive_count", "result", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$"},
    "model": {"type": "string", "minLength": 1},
    "identity_rule": {"const": "exact_model_layer_feature"},
    "feature": {
      "type": "object", "additionalProperties": false,
      "required": ["layer", "feature_index"],
      "properties": {
        "layer": {"type": "integer", "minimum": 0},
        "feature_index": {"type": "integer", "minimum": 0}
      }
    },
    "minimum_contexts": {"type": "integer", "minimum": 3},
    "contexts": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["session_id", "graph_id", "node_id", "prompt", "target", "attribution_id", "activation_evidence_id", "intervention_id", "neural_evidence_id", "result"],
        "properties": {
          "session_id": {"type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$"},
          "graph_id": {"type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$"},
          "node_id": {"type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$"},
          "prompt": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "attribution_id": {"type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$"},
          "activation_evidence_id": {"type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$"},
          "intervention_id": {"type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$"},
          "neural_evidence_id": {"type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$"},
          "result": {"enum": ["supports", "contradicts", "inconclusive"]}
        }
      }
    },
    "supporting_count": {"type": "integer", "minimum": 0},
    "contradicting_count": {"type": "integer", "minimum": 0},
    "inconclusive_count": {"type": "integer", "minimum": 0},
    "result": {"enum": ["supports", "contradicts", "inconclusive"]},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
