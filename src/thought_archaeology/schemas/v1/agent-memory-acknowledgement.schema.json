{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mela.ai/schemas/thought-archaeology/v1/agent-memory-acknowledgement.schema.json",
  "title": "AgentMemoryAcknowledgement",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "receipt_id", "receipt_kind", "collaborator_id", "created_at", "client_request_id", "request_sha256", "visibility", "transport"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "receipt_id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "receipt_kind": { "enum": ["interaction", "path_completion"] },
    "collaborator_id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "client_request_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "request_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "external_memory_ref": { "type": "string", "minLength": 1, "maxLength": 500 },
    "visibility": { "const": "private" },
    "transport": { "const": "mcp" }
  }
}
