{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mela.ai/schemas/thought-archaeology/v1/portable-inquiry.schema.json",
  "title": "Portable inquiry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "id",
    "content"
  ],
  "properties": {
    "format": {
      "const": "atlas-inquiry"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin_id",
        "author",
        "description",
        "session",
        "graphs",
        "evidence",
        "omitted_evidence_count"
      ],
      "properties": {
        "origin_id": {
          "type": "string",
          "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$"
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "session": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "title",
            "created_at",
            "updated_at",
            "head_graph_id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "created_at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
            },
            "updated_at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
            },
            "head_graph_id": {
              "type": "string",
              "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$"
            }
          }
        },
        "graphs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "graph",
              "source_sha256",
              "shared_sha256",
              "role",
              "source"
            ],
            "properties": {
              "graph": {
                "$ref": "thought-graph.schema.json"
              },
              "source_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "shared_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "role": {
                "enum": [
                  "user",
                  "assistant",
                  "human_edit",
                  "system"
                ]
              },
              "source": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "graph_id",
                      "node_id",
                      "question",
                      "author"
                    ],
                    "properties": {
                      "graph_id": {
                        "type": "string",
                        "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$"
                      },
                      "node_id": {
                        "type": "string",
                        "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$"
                      },
                      "question": {
                        "type": "string",
                        "minLength": 0,
                        "maxLength": 8000
                      },
                      "author": {
                        "type": "string",
                        "minLength": 0,
                        "maxLength": 240
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "evidence-binding.schema.json"
          }
        },
        "omitted_evidence_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
