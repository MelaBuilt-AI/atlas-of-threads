{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mela.ai/schemas/thought-archaeology/v1/fingerprint.schema.json",
  "title": "Fingerprint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "created_at",
    "session_ids",
    "min_sessions",
    "merge_threshold",
    "model_taste",
    "human_vetoes",
    "divergence"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "session_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" }
    },
    "min_sessions": { "type": "integer", "minimum": 1 },
    "merge_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
    "model_taste": {
      "type": "array",
      "items": { "$ref": "#/$defs/cluster" }
    },
    "human_vetoes": {
      "type": "array",
      "items": { "$ref": "#/$defs/cluster" }
    },
    "divergence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["taste_canonical", "veto_canonical", "jaccard"],
        "properties": {
          "taste_canonical": { "type": "string", "minLength": 1 },
          "veto_canonical": { "type": "string", "minLength": 1 },
          "jaccard": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  },
  "$defs": {
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical",
        "normalized",
        "count",
        "session_ids",
        "node_ids",
        "recurrence"
      ],
      "properties": {
        "canonical": { "type": "string", "minLength": 1 },
        "normalized": { "type": "string" },
        "count": { "type": "integer", "minimum": 1 },
        "session_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$"
          }
        },
        "node_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$"
          }
        },
        "recurrence": { "type": "string", "enum": ["recurring", "emerging"] }
      }
    }
  }
}
