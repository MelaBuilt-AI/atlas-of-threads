{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mela.ai/schemas/thought-archaeology/v1/parallel-continuation-batch.schema.json",
  "title": "ParallelContinuationBatch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "session_id", "graph_id", "node_id", "created_at", "prompt", "source", "jobs"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "session_id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "graph_id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "node_id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "prompt": { "type": "string", "minLength": 1, "maxLength": 400 },
    "source": { "const": "workspace" },
    "jobs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "harness", "position"],
        "properties": {
          "request_id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
          "harness": { "type": "string", "minLength": 1, "maxLength": 64 },
          "position": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
