{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mela.ai/schemas/thought-archaeology/v1/evidence-binding.schema.json",
  "title": "EvidenceBinding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "graph_id",
    "node_id",
    "kind",
    "result",
    "summary",
    "artifact_refs",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "graph_id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "node_id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "kind": {
      "type": "string",
      "enum": [
        "story_report",
        "context_provenance",
        "behavioral_intervention",
        "activation_correlation",
        "neural_intervention",
        "recurring_circuit",
        "training_influence",
        "training_provenance",
        "checkpoint_emergence"
      ]
    },
    "result": {
      "type": "string",
      "enum": ["supports", "contradicts", "inconclusive"]
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "artifact_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "parent_evidence_id": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" }
      ]
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
