{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mela.ai/schemas/thought-archaeology/v1/continuation-failure.schema.json",
  "title": "ContinuationFailure",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "request_id", "created_at", "harness", "reason_code", "public_summary"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "request_id": { "type": "string", "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$" },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "harness": { "type": "string", "minLength": 1, "maxLength": 64 },
    "reason_code": { "type": "string", "enum": ["adapter_error", "timeout", "interrupted", "invalid_response", "unavailable_harness"] },
    "public_summary": { "type": "string", "minLength": 1, "maxLength": 240 }
  }
}
